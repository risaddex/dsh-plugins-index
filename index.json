    {
      "name": "dsh-plugin-ombrello-toolset",
      "title": {
        "en": "Ombrello toolset",
        "pt-br": "Toolset Ombrello"
      },
      "description": {
        "en": "Connects the Ombrello toolset MCP server hosted on the Obot gateway and adds OAuth 2.0 sign-in with automatic token refresh. The gateway tools appear as mcp__ombrello_toolset__* and the bearer token is kept in the credentials store, never in configuration.",
        "pt-br": "Conecta o servidor MCP do toolset Ombrello hospedado no gateway Obot e acrescenta login OAuth 2.0 com renovação automática do token. As ferramentas do gateway aparecem como mcp__ombrello_toolset__* e o token fica no cofre de credenciais, nunca na configuração."
      },

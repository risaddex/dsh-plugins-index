    {
      "name": "dsh-plugin-pr-autofix",
      "title": {
        "en": "PR Auto-fix",
        "pt-br": "PR Auto-fix"
      },
      "description": {
        "en": "Watches the session's pull request on GitHub (github.com or Enterprise) or a self-hosted Gitea instance (gt CLI on Gitea 28+, tea fallback) and wakes the agent with a <ci-monitor-event> on CI failures, merge conflicts and new review comments. Adds a PR Auto-fix tab to the right sidebar; complements dsh-git-manager.",
        "pt-br": "Monitora o pull request da sessão no GitHub (github.com ou Enterprise) ou em uma instância Gitea (CLI gt no Gitea 28+, tea como fallback) e acorda o agente com um <ci-monitor-event> em falha de CI, conflito de merge e novos comentários de review. Adiciona a aba PR Auto-fix no sidebar direito; complementa o dsh-git-manager."
      },
      "author": "risaddex",
      "homepage": "https://github.com/risaddex/dsh-plugins/tree/main/packages/dsh-plugin-pr-autofix",
